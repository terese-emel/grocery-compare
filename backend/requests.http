@baseUrl = http://localhost:3000
@productId = returned-id-here
@auth_token = replace-me-with-a-valid-jwt

###############################################
# Health
###############################################

GET {{baseUrl}}/health

###############################################
# Register
###############################################

###

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

###############################################
# Login and save JWT automatically
###############################################

###
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

###

###############################################
# Dynamic token
###############################################

@auth_token = {{login.response.body.$.token}}

###############################################
# Get all products
###############################################

###

GET {{baseUrl}}/products
Authorization: Bearer {{auth_token}}

###############################################
# Create product
###############################################

###

POST {{baseUrl}}/products
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "name": "Arla Milk 1L",
  "shop": "Coop",
  "price": 10.9,
  "unit": "1L"
}

###############################################
# Get one product
###############################################

###

GET {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{auth_token}}

###############################################
# Update product price
###############################################

###

PATCH {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "price": 20.9
}

###############################################
# Delete product
###############################################

###

DELETE {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{auth_token}}

###############################################
# Search by name
###############################################

###

GET {{baseUrl}}/products?name=milk
Authorization: Bearer {{auth_token}}

###############################################
# Cheapest products
###############################################

###

GET {{baseUrl}}/products/cheapest?name=milk
Authorization: Bearer {{auth_token}}